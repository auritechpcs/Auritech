---
import BaseLayout from '../layouts/BaseLayout.astro';
const diamondBuilds = [
  // Featured from the Diamond PCs 2026 lineup. List price only (no compare-at in source).
  { name: "Core Ultra 7 265KF + RX 9060 XT", tier: "Best Value", price: 2399, sale: null, color: "#a0a0a0",
    photo: "https://diamondpcs.ca/cdn/shop/files/9060xt_white_sp_case.png?v=1768322923",
    photos: ["https://diamondpcs.ca/cdn/shop/files/9060xt_white_sp_case.png?v=1768322923","https://diamondpcs.ca/cdn/shop/files/906xtwhite.png?v=1768322923"],
    parts: [{item:"CPU",part:"Core Ultra 7 265KF"},{item:"GPU",part:"RX 9060 XT 16GB"},{item:"RAM",part:"32GB DDR5-6000"},{item:"Cooling",part:"Thermalright 360mm AIO"},{item:"Storage",part:"512GB NVMe SSD"},{item:"Shipping",part:"$99 Flat Canada Wide"}] },
  { name: "Ryzen 7 7800X3D + RTX 5070", tier: "High-FPS", price: 3199, sale: null, color: "#C9A84C",
    photo: "https://diamondpcs.ca/cdn/shop/files/infinit3.0.png?v=1768411876",
    photos: ["https://diamondpcs.ca/cdn/shop/files/infinit3.0.png?v=1768411876","https://diamondpcs.ca/cdn/shop/files/infiniti2.0.png?v=1768411876"],
    parts: [{item:"CPU",part:"Ryzen 7 7800X3D"},{item:"GPU",part:"RTX 5070 12GB"},{item:"RAM",part:"32GB DDR5-6000"},{item:"Cooling",part:"Thermalright 360mm AIO"},{item:"Storage",part:"512GB NVMe SSD"},{item:"Shipping",part:"$99 Flat Canada Wide"}] },
  { name: "Ryzen 7 7800X3D + RTX 5080", tier: "Flagship", price: 4299, sale: null, color: "#e8d48a",
    photo: "https://diamondpcs.ca/cdn/shop/files/whte_corsair_3500x_d379b833-cf0a-43b0-ad4a-849fb54e45d6.png?v=1769716735",
    photos: ["https://diamondpcs.ca/cdn/shop/files/whte_corsair_3500x_d379b833-cf0a-43b0-ad4a-849fb54e45d6.png?v=1769716735","https://diamondpcs.ca/cdn/shop/files/updates_white_3500x_05691067-4a19-4111-a08c-0cd57c1f44fb.png?v=1769716719"],
    parts: [{item:"CPU",part:"Ryzen 7 7800X3D"},{item:"GPU",part:"RTX 5080 16GB"},{item:"RAM",part:"32GB DDR5-6000"},{item:"Cooling",part:"Thermalright 360mm AIO"},{item:"Storage",part:"512GB NVMe SSD"},{item:"Shipping",part:"$99 Flat Canada Wide"}] },
];
---
<BaseLayout title="Home" description="Auritech PCs, custom PC builder in Windsor, Ontario. Same day local pickup, Canada wide shipping. Gaming PCs, custom builds, and preconfigured computers. Every build stress tested.">

  <!-- Hero -->
  <section id="hero" style="min-height:92vh;display:flex;align-items:center;justify-content:center;text-align:center;padding:80px 24px;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 30%,rgba(201,168,76,0.06) 0%,transparent 70%);pointer-events:none;"></div>
    <div style="position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0.3;"></div>

    <div style="max-width:960px;position:relative;z-index:1;">
      <h1 style="font-size:clamp(2.5rem,7vw,5rem);line-height:1.1;margin-bottom:24px;">
        <span class="hero-in" style="display:block;">The Gold Standard</span>
        <span class="hero-in" style="display:block;color:var(--gold);">in Custom PCs</span>
      </h1>
      <p class="hero-in" style="font-size:clamp(15px,2vw,18px);color:var(--text2);max-width:580px;margin:0 auto 40px;line-height:1.8;">
        A gaming PC that runs your games right, priced so you can check it against Marketplace, from two Windsor builders who've done this since 2021 and still answer their own phones. Pick it up locally or get it shipped anywhere in Canada.
      </p>
      <div class="hero-in" style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="/custom-build" class="btn btn-gold">Build Your PC</a>
        <a href="sms:+15199994609" class="btn btn-outline">Text (519) 999-4609</a>
      </div>
      <div class="hero-in" style="display:flex;gap:40px;justify-content:center;flex-wrap:wrap;margin-top:72px;padding-top:40px;border-top:1px solid rgba(201,168,76,0.12);">
        <div style="text-align:center;">
          <div class="hero-stat">100%</div>
          <div class="hero-stat-label">Stress Tested</div>
        </div>
        <div style="text-align:center;">
          <div class="hero-stat">48hr</div>
          <div class="hero-stat-label">Avg Build Time</div>
        </div>
        <div style="text-align:center;">
          <div class="hero-stat" id="stat-sold">110+</div>
          <div class="hero-stat-label">Builds Sold</div>
        </div>
        <div style="text-align:center;">
          <div class="hero-stat">Canada</div>
          <div class="hero-stat-label">Wide Delivery</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Auritech -->
  <section style="padding:80px 24px;max-width:1100px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:60px;">
      <h2 class="section-title">Built Different</h2>
    </div>
    <div class="stagger-children" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px;">
      <div class="feature-card" style="background:var(--surface);border:1px solid rgba(201,168,76,0.1);border-radius:var(--radius);padding:32px;transition:border-color 0.2s,transform 0.2s;">
        <div style="width:48px;height:48px;background:rgba(201,168,76,0.08);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        </div>
        <h3 style="font-size:16px;letter-spacing:1px;margin-bottom:10px;">Performance First</h3>
        <p style="font-size:14px;color:var(--text2);line-height:1.7;">Every component chosen for max FPS, thermals, and longevity. No filler parts, no shortcuts.</p>
      </div>
      <div class="feature-card" style="background:var(--surface);border:1px solid rgba(201,168,76,0.1);border-radius:var(--radius);padding:32px;transition:border-color 0.2s,transform 0.2s;">
        <div style="width:48px;height:48px;background:rgba(201,168,76,0.08);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <h3 style="font-size:16px;letter-spacing:1px;margin-bottom:10px;">Custom or Pre-Built</h3>
        <p style="font-size:14px;color:var(--text2);line-height:1.7;">Tell us your use case and budget and we build it. Or grab one of our ready-to-ship machines.</p>
      </div>
      <div class="feature-card" style="background:var(--surface);border:1px solid rgba(201,168,76,0.1);border-radius:var(--radius);padding:32px;transition:border-color 0.2s,transform 0.2s;">
        <div style="width:48px;height:48px;background:rgba(201,168,76,0.08);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </div>
        <h3 style="font-size:16px;letter-spacing:1px;margin-bottom:10px;">Local to Windsor</h3>
        <p style="font-size:14px;color:var(--text2);line-height:1.7;">Come pick it up same day. No waiting weeks for shipping. Real people, real builds.</p>
      </div>
      <div class="feature-card" style="background:var(--surface);border:1px solid rgba(201,168,76,0.1);border-radius:var(--radius);padding:32px;transition:border-color 0.2s,transform 0.2s;">
        <div style="width:48px;height:48px;background:rgba(201,168,76,0.08);border-radius:var(--radius);display:flex;align-items:center;justify-content:center;margin-bottom:20px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--gold)" stroke-width="1.5"><path d="M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6"/></svg>
        </div>
        <h3 style="font-size:16px;letter-spacing:1px;margin-bottom:10px;">Transparent Pricing</h3>
        <p style="font-size:14px;color:var(--text2);line-height:1.7;">You see every part, every cost. No mystery margins or bloatware bundled in.</p>
      </div>
    </div>
  </section>

  <!-- Reviews / Social Proof -->
  <section style="padding:80px 0;background:var(--surface);border-top:1px solid rgba(201,168,76,0.08);border-bottom:1px solid rgba(201,168,76,0.08);overflow:hidden;">
    <div class="reveal" style="text-align:center;margin-bottom:48px;padding:0 24px;">
      <h2 class="section-title">Trusted in Windsor</h2>
      <!-- Aggregate rating badge -->
      <div style="display:inline-flex;align-items:center;gap:12px;margin-top:18px;background:rgba(201,168,76,0.06);border:1px solid rgba(201,168,76,0.2);border-radius:100px;padding:10px 22px;">
        <svg width="20" height="20" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.27-4.74 3.27-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84A11 11 0 0012 23z"/><path fill="#FBBC05" d="M5.84 14.1a6.6 6.6 0 010-4.2V7.06H2.18a11 11 0 000 9.88l3.66-2.84z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15A11 11 0 0012 1a11 11 0 00-9.82 6.06l3.66 2.84C6.71 7.3 9.14 5.38 12 5.38z"/></svg>
        <span style="font-size:18px;font-weight:700;color:var(--gold);" id="rev-avg">5.0</span>
        <span style="color:var(--gold);letter-spacing:2px;font-size:15px;">★★★★★</span>
        <span style="font-size:13px;color:var(--text2);" id="rev-count">Google Reviews</span>
      </div>
    </div>
    <!-- Auto-scrolling marquee of review cards -->
    <div class="review-marquee">
      <div class="review-track" id="review-track">
        <!-- cards injected by script (duplicated for seamless loop) -->
      </div>
    </div>
    <div class="reveal" style="text-align:center;margin-top:40px;padding:0 24px;">
      <a id="rev-google-link" href="https://www.google.com/maps" target="_blank" rel="noopener" class="btn btn-outline" style="padding:12px 28px;font-size:11px;">See all our reviews on Google</a>
    </div>
  </section>

  <!-- Auritech Builds — Same Day Pickup -->
  <section style="padding:80px 24px;max-width:1100px;margin:0 auto;">
    <div style="text-align:center;margin-bottom:48px;">
      <h2 class="section-title">Same Day Pickup Builds</h2>
      <p style="font-size:15px;color:var(--text2);margin-top:12px;">Fully assembled, tested, and ready. Walk in and take it home. No wait.</p>
    </div>
    <div id="home-inventory" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(320px,100%),380px));gap:24px;justify-content:center;">
      <div style="text-align:center;padding:60px 0;color:var(--text2);font-size:14px;grid-column:1/-1;">Loading builds...</div>
    </div>
    <div id="home-inventory-all" style="text-align:center;margin-top:40px;" hidden>
      <a href="/inventory" class="btn btn-outline">View All Same Day Pickup →</a>
    </div>
  </section>

  <!-- Featured Diamond Builds -->
  <section style="padding:80px 24px;background:var(--surface);border-top:1px solid rgba(201,168,76,0.08);border-bottom:1px solid rgba(201,168,76,0.08);">
    <div style="max-width:1100px;margin:0 auto;">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:48px;flex-wrap:wrap;gap:16px;">
        <div>
          <h2 class="section-title">Featured Builds</h2>
          <p style="font-size:15px;color:var(--text2);">Our DiamondPC line, assembled to order. Every part listed, every price shown.</p>
        </div>
        <a href="/preconfigured" class="btn btn-outline" style="font-size:11px;">View All →</a>
      </div>
      <div class="stagger-children" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:24px;">
        {diamondBuilds.map(b=>(
          <div class="build-card" tabindex="0" role="button" aria-label={`View ${b.name}`} style="background:var(--surface2);border:1px solid rgba(201,168,76,0.22);border-radius:var(--radius);overflow:hidden;transition:all 0.2s;cursor:pointer;"
            onclick={`openBuildModal(${JSON.stringify({name:b.name,price:b.price,sale:b.sale,parts:b.parts,photos:b.photos,type:'preconfigured'})})`}>
            <div style="position:relative;height:220px;background:#0d0d0d;border-bottom:1px solid rgba(201,168,76,0.18);overflow:hidden;display:flex;align-items:center;justify-content:center;">
              <img src={b.photo} alt={b.name} loading="lazy" style="max-width:100%;max-height:100%;object-fit:contain;padding:16px;transition:transform 0.4s ease;" onmouseover="this.style.transform='scale(1.04)'" onmouseout="this.style.transform='scale(1)'" />
              <div style={`position:absolute;top:12px;left:12px;display:flex;align-items:center;gap:6px;background:rgba(0,0,0,0.6);backdrop-filter:blur(8px);border:1px solid rgba(${b.color === '#e8d48a' ? '232,212,138' : b.color === '#C9A84C' ? '201,168,76' : '160,160,160'},0.25);border-radius:100px;padding:4px 12px;`}>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke={b.color} stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <span style={`font-size:9px;letter-spacing:2px;text-transform:uppercase;color:${b.color};`}>{b.tier}</span>
              </div>
            </div>
            <div style="padding:20px 24px 24px;">
              <div style="font-family:'Cinzel',serif;font-size:16px;letter-spacing:1px;margin-bottom:8px;">{b.name}</div>
              <div style="font-size:12px;color:var(--text2);margin-bottom:16px;line-height:1.6;">{b.parts.slice(0,3).map(p=>p.part).join(' · ')}</div>
              <div class="gold-line" style="margin-bottom:16px;"></div>
              <div style="display:flex;justify-content:space-between;align-items:flex-end;">
                <div>
                  {b.sale && <div style="font-size:11px;color:var(--text3);text-decoration:line-through;">${b.sale.toLocaleString()} CAD</div>}
                  <div style="font-family:'Cinzel',serif;font-size:20px;color:var(--gold);">${b.price.toLocaleString()} CAD</div>
                </div>
                <span style="font-size:11px;color:var(--text2);letter-spacing:1px;">View details →</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA: the two people behind every build -->
  <section style="padding:0 24px;">
    <div style="height:1px;background:linear-gradient(90deg,transparent,rgba(201,168,76,0.3),transparent);"></div>

    <div class="cta-grid" style="max-width:1100px;margin:0 auto;padding:80px 0;display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;">
      <div>
        <h2 style="font-size:clamp(2rem,4vw,3.2rem);line-height:1.15;margin-bottom:20px;">Text Us.<br><span style="color:var(--gold);">We Actually Answer.</span></h2>
        <p style="font-size:15px;color:var(--text2);line-height:1.9;margin-bottom:36px;max-width:440px;">Tell us your budget and the games you play. We'll spec it, build it, stress test it for 24 hours, and have it ready for pickup in Windsor or shipped for $99 anywhere in Canada.</p>
        <a href="/custom-build" class="btn btn-gold" style="padding:14px 32px;">Start Your Custom Build</a>
      </div>

      <div style="background:var(--surface);border:1px solid rgba(201,168,76,0.2);border-radius:var(--radius);padding:28px;">
        <div class="person">
          <div class="person-avatar" aria-hidden="true">M</div>
          <div class="person-who">
            <div class="person-name">Motasem Klaibi</div>
            <div class="person-num">(519) 999-4609</div>
          </div>
          <div class="person-actions">
            <a href="sms:+15199994609" class="contact-pill" aria-label="Text Motasem">Text</a>
            <a href="tel:+15199994609" class="contact-pill" aria-label="Call Motasem">Call</a>
          </div>
        </div>
        <div class="person">
          <div class="person-avatar" aria-hidden="true">A</div>
          <div class="person-who">
            <div class="person-name">Ahmed Alasi</div>
            <div class="person-num">(506) 312-2991</div>
          </div>
          <div class="person-actions">
            <a href="sms:+15063122991" class="contact-pill" aria-label="Text Ahmed">Text</a>
            <a href="tel:+15063122991" class="contact-pill" aria-label="Call Ahmed">Call</a>
          </div>
        </div>
        <ul class="promise-list">
          <li>Free consultation on your build</li>
          <li>Every build stress tested for 24 hours</li>
          <li>Satisfaction guarantee on every build</li>
          <li>A $50 deposit holds your build, fully refundable until parts are ordered</li>
        </ul>
      </div>
    </div>

    <div style="height:1px;background:linear-gradient(90deg,transparent,rgba(201,168,76,0.15),transparent);"></div>

    <style>
      @media (max-width: 768px) {
        .cta-grid { grid-template-columns: 1fr !important; gap: 40px !important; }
      }
      .person { display:flex; align-items:center; gap:14px; padding:14px 0; border-bottom:1px solid rgba(201,168,76,0.1); }
      .person-avatar { width:44px; height:44px; flex-shrink:0; border-radius:50%; background:linear-gradient(135deg,var(--gold-dim),var(--gold)); color:#000; font-family:'Cinzel',serif; font-weight:700; font-size:17px; display:flex; align-items:center; justify-content:center; }
      .person-who { flex:1; min-width:0; }
      .person-name { font-family:'Cinzel',serif; font-size:15px; letter-spacing:1px; color:var(--text); }
      .person-num { font-size:13px; color:var(--text2); margin-top:2px; font-variant-numeric:tabular-nums; }
      .person-actions { display:flex; gap:8px; flex-shrink:0; }
      .promise-list { list-style:none; margin-top:20px; display:flex; flex-direction:column; gap:10px; }
      .promise-list li { position:relative; padding-left:24px; font-size:13px; color:var(--text2); line-height:1.6; }
      .promise-list li::before { content:''; position:absolute; left:2px; top:5px; width:12px; height:6px; border-left:2px solid var(--gold); border-bottom:2px solid var(--gold); transform:rotate(-45deg); }
      @media (max-width: 400px) {
        .person { flex-wrap:wrap; }
        .person-actions { width:100%; padding-left:58px; }
      }
    </style>
  </section>

  <!-- Build Detail Modal -->
  <div id="build-modal-overlay" onclick="if(event.target===this)closeBuildModal()" style="position:fixed;inset:0;background:rgba(0,0,0,0.88);backdrop-filter:blur(12px);z-index:2000;display:none;align-items:center;justify-content:center;padding:20px;">
    <div role="dialog" aria-modal="true" aria-labelledby="bm-name" style="background:var(--surface);border:1px solid rgba(201,168,76,0.15);border-radius:6px;width:min(960px,96vw);max-height:90vh;overflow:hidden;display:flex;flex-direction:column;">
      <!-- Header -->
      <div style="display:flex;justify-content:space-between;align-items:center;padding:20px 28px;border-bottom:1px solid rgba(255,255,255,0.06);">
        <div>
          <div id="bm-name" style="font-family:'Cinzel',serif;font-size:19px;letter-spacing:1px;"></div>
          <div id="bm-price" style="font-size:15px;color:var(--gold);margin-top:3px;font-family:'Cinzel',serif;"></div>
        </div>
        <button onclick="closeBuildModal()" class="modal-close" aria-label="Close">×</button>
      </div>
      <!-- Body -->
      <div style="display:flex;flex:1;overflow:hidden;min-height:0;">
        <!-- Left: photos -->
        <div id="bm-photo-col" style="flex:1;display:flex;flex-direction:column;padding:20px;gap:12px;min-width:0;">
          <div style="position:relative;flex:1;background:#0a0a0a;border-radius:10px;overflow:hidden;display:flex;align-items:center;justify-content:center;min-height:300px;">
            <img id="bm-main-img" src="" alt="" style="max-width:100%;max-height:420px;object-fit:contain;padding:16px;" />
            <button id="bm-prev" onclick="bmNav(-1)" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);background:rgba(0,0,0,0.6);border:1px solid rgba(201,168,76,0.3);color:var(--gold);border-radius:50%;width:38px;height:38px;cursor:pointer;font-size:18px;display:none;align-items:center;justify-content:center;">‹</button>
            <button id="bm-next" onclick="bmNav(1)" style="position:absolute;right:10px;top:50%;transform:translateY(-50%);background:rgba(0,0,0,0.6);border:1px solid rgba(201,168,76,0.3);color:var(--gold);border-radius:50%;width:38px;height:38px;cursor:pointer;font-size:18px;display:none;align-items:center;justify-content:center;">›</button>
            <div id="bm-counter" style="position:absolute;bottom:10px;left:50%;transform:translateX(-50%);font-size:11px;color:var(--text3);background:rgba(0,0,0,0.5);padding:2px 12px;border-radius:100px;"></div>
          </div>
          <div id="bm-thumbs" style="display:flex;gap:8px;flex-wrap:wrap;"></div>
        </div>
        <!-- Right: specs + CTA -->
        <div style="width:280px;flex-shrink:0;border-left:1px solid rgba(255,255,255,0.06);padding:24px;display:flex;flex-direction:column;overflow-y:auto;">
          <div style="font-size:10px;letter-spacing:2px;color:var(--gold);opacity:0.6;margin-bottom:14px;text-transform:uppercase;">Specifications</div>
          <div id="bm-specs" style="flex:1;font-size:13px;"></div>
