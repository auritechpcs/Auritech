  <script type="module">
    // ── GOOGLE REVIEWS (real, curated from our 5.0★ / 23-review listing) ──
    (function renderReviews() {
      const GOOGLE_URL = "https://maps.app.goo.gl/KqxVwUwQBKtFdm3d8";
      const reviews = [
        { name: "Josh Lahoud", when: "6 days ago", stars: 5,
          text: "9:30pm on a Sunday I call this beauty with a question, the man was on the phone with me for almost 10 minutes going thru everything that could possibly be an issue. If I could give him 10 stars I would. Super helpful, big time recommend. 10/10 experience." },
        { name: "Khush Hirani", when: "2 weeks ago", stars: 5,
          text: "Got a custom PC from these guys, absolutely game changer for me. Service is great, prices are affordable and got it delivered home. Couldn't be happier. 100% recommend." },
        { name: "Abubakr Sheltami", when: "2 months ago", stars: 5,
          text: "The team was helpful, communication was good, and the PC came exactly how I wanted it. Build quality was solid and everything ran great right away. Definitely a company I'd recommend if you're looking for a custom PC." },
        { name: "Syed Issam", when: "2 months ago", stars: 5,
          text: "I just recently bought a 3090 build and it performs fantastic! It was a great experience dealing with them, really good pricing compared to the market, and respectful dudes. Do try em out if you're looking for a PC." },
        { name: "Danial Bajwa", when: "a month ago", stars: 5,
          text: "I bought a PC from them, they were convenient with the delivery, with impressive customer service delivered to my home. Exactly the components I needed. Looking forward to continue purchasing along with their modest prices." },
      ];
      const esc = (s) => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
      const card = (r) => `
        <div class="review-card">
          <div class="stars">${'★'.repeat(r.stars)}</div>
          <div class="body">"${esc(r.text)}"</div>
          <div class="who">
            <div class="avatar">${esc(r.name.trim()[0] || 'A')}</div>
            <div><div class="name">${esc(r.name)}</div><div class="when">${esc(r.when)} · Google</div></div>
          </div>
        </div>`;
      const track = document.getElementById('review-track');
      if (track) {
        // duplicate the set so the marquee loops seamlessly
        track.innerHTML = (reviews.map(card).join('') + reviews.map(card).join(''));
      }
      const cnt = document.getElementById('rev-count'); if (cnt) cnt.textContent = '5.0 · 23 Google reviews';
      const link = document.getElementById('rev-google-link'); if (link) link.href = GOOGLE_URL;
    })();

    const firebaseConfig = {
      apiKey: "AIzaSyDA5XLxDqjzQb3toHkKpSxEVH9NW1GeD68",
      authDomain: "open-claw-b7e92.firebaseapp.com",
      databaseURL: "https://open-claw-b7e92-default-rtdb.firebaseio.com",
      projectId: "open-claw-b7e92",
      storageBucket: "open-claw-b7e92.firebasestorage.app",
      messagingSenderId: "733756283803",
      appId: "1:733756283803:web:0e9c75cd1c0afe94bb1f3e"
    };

    // Firebase loads on its own, so a slow or blocked gstatic never holds up the
    // hero, the reviews or the build modals.
    (async () => {
      try {
        const [{ initializeApp, getApps }, { getDatabase, ref, onValue }] = await Promise.all([
          import('https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js'),
          import('https://www.gstatic.com/firebasejs/10.7.1/firebase-database.js'),
        ]);
        const app = getApps().length ? getApps()[0] : initializeApp(firebaseConfig);
        onValue(ref(getDatabase(app), 'auritech_inventory_v2'), (snap) => renderShelf(snap.val()),
          () => renderShelf(null, true));
      } catch {
        renderShelf(null, true);
      }
    })();

    // Escapes for text AND quoted attributes (quotes included), since database
    // values land inside attributes like src="..." and alt="...".
    function esc(s) {
      return String(s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }
    // Returns the normalized https URL (or ''); still esc() it when interpolating.
    function safeImgSrc(url) {
      try { const u = new URL(url); return u.protocol === 'https:' ? u.href : ''; }
      catch { return ''; }
    }

    function partOrder(p) {
      const t = (p.item || '').toLowerCase();
      if (t.includes('cpu') && !t.includes('cooler')) return 0;
      if (t.includes('gpu') || t.includes('graphic')) return 1;
      if (t.includes('ram') || t.includes('memory')) return 2;
      if (t.includes('storage') || t.includes('ssd') || t.includes('hdd') || t.includes('nvme')) return 3;
      if (t.includes('mobo') || t.includes('motherboard')) return 4;
      if (t.includes('cooler')) return 5;
      if (t.includes('case') || t.includes('chassis')) return 6;
      if (t.includes('power') || t.includes('psu')) return 7;
      if (t.includes('extra') || t.includes('misc')) return 9;
      return 8;
    }

    let homeListedBuilds = [];

    function buildCard(b, idx) {
      const photos = (b.photos || []).map(safeImgSrc).filter(Boolean);
      const photoCount = photos.length;
      const price = b.listPrice || b.listingPrice || b.salePrice || '';
      const name = b.name || 'Custom Build';
      const escapedName = esc(name);
      const partsArr = Array.isArray(b.parts) ? b.parts.filter(p => !p.hidden).sort((a, b) => partOrder(a) - partOrder(b)) : [];
      const img = photoCount
        ? `<div style="height:240px;background:#0d0d0d;border-bottom:1px solid rgba(201,168,76,0.18);display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative;">
            <img src="${esc(photos[0])}" alt="${escapedName}" style="max-width:100%;max-height:100%;object-fit:contain;padding:12px;transition:transform 0.3s;" />
            ${photoCount > 1 ? `<div style="position:absolute;bottom:10px;right:10px;background:rgba(0,0,0,0.7);border-radius:100px;font-size:11px;padding:3px 10px;color:var(--text2);backdrop-filter:blur(4px);">+${photoCount-1} photos</div>` : ''}
          </div>`
        : `<div style="height:180px;background:var(--surface2);border-bottom:1px solid rgba(201,168,76,0.18);display:flex;align-items:center;justify-content:center;">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--text3)" stroke-width="1"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>`;
      return `<div class="build-card" tabindex="0" role="button" aria-label="View ${escapedName}" style="background:var(--surface);border:1px solid rgba(201,168,76,0.22);border-radius:var(--radius);overflow:hidden;transition:all 0.2s;cursor:pointer;" onclick="openHomeInventoryModal(${idx})">
        ${img}
        <div style="padding:24px;">
          <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:12px;">
            <div style="font-family:'Cinzel',serif;font-size:16px;letter-spacing:1px;">${escapedName}</div>
            <span style="font-size:10px;letter-spacing:1.5px;text-transform:uppercase;background:var(--gold-glow);color:var(--gold);border:1px solid rgba(201,168,76,0.35);border-radius:100px;padding:3px 10px;white-space:nowrap;flex-shrink:0;">Same Day Pickup</span>
          </div>
          <div class="gold-line" style="margin-bottom:16px;"></div>
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <div style="font-family:'Cinzel',serif;font-size:20px;color:var(--gold);">${price ? '$'+Number(price).toLocaleString()+' CAD' : 'Contact Us'}</div>
            <span style="font-size:11px;color:var(--text2);letter-spacing:1px;">View details →</span>
          </div>
        </div>
      </div>`;
    }

    // Shown when nothing is listed: points at the bench and the phone instead of a dead end.
    function emptyShelf(inProgress, failed) {
      const line = failed
        ? "We couldn't load the shelf just now. Text us and we'll tell you what's ready today."
        : inProgress > 0
          ? `${inProgress} build${inProgress === 1 ? ' is' : 's are'} on our bench right now. Text Motasem to hear about ${inProgress === 1 ? 'it' : 'them'} before ${inProgress === 1 ? "it's" : "they're"} listed.`
          : "Text us what you're after and we'll tell you what's coming next.";
      return `<div class="shelf-empty">
          <div class="shelf-empty-title">${failed ? 'Shelf unavailable' : 'Nothing on the shelf right now'}</div>
          <p>${line}</p>
          <a href="sms:+15199994609" class="btn btn-outline">Text Motasem</a>
        </div>`;
    }

    function renderShelf(data, failed = false) {
      // Live count of builds actually sold, rounded down to the nearest 10.
      const sold = (data?.soldBuilds || []).filter(Boolean).length;
      if (sold >= 10) document.getElementById('stat-sold').textContent = `${Math.floor(sold / 10) * 10}+`;

      const container = document.getElementById('home-inventory');
      const viewAll = document.getElementById('home-inventory-all');
      const builds = (data?.builds || []).filter(Boolean);
      const listed = builds.filter(b => b.status === 'listed');
      viewAll.hidden = !listed.length;
      if (!listed.length) {
        container.innerHTML = emptyShelf(builds.filter(b => b.status === 'in-progress').length, failed);
        return;
      }
      homeListedBuilds = listed.slice(0, 3);
      container.innerHTML = homeListedBuilds.map((b, i) => buildCard(b, i)).join('');
    }

    window.openHomeInventoryModal = (idx) => {
      const b = homeListedBuilds[idx];
      if (!b) return;
      openBuildModal({
        name: b.name,
        price: b.listPrice || b.listingPrice || b.salePrice || '',
        photos: (b.photos || []).map(safeImgSrc).filter(Boolean),
        parts: Array.isArray(b.parts) ? b.parts.filter(p => !p.hidden).sort((a, bb) => partOrder(a) - partOrder(bb)) : [],
        type: 'product'
      });
    };

    // ── BUILD DETAIL MODAL ──
    let bmPhotos = [], bmIdx = 0, bmCurrent = {}, bmOpener = null;
    window.openBuildModal = (data) => {
      bmCurrent = data;
      bmOpener = document.activeElement;
      bmPhotos = data.photos || [];
      bmIdx = 0;
      const price = data.price;
      document.getElementById('bm-name').textContent = data.name || '';
      document.getElementById('bm-price').textContent = price ? '$' + Number(price).toLocaleString() + ' CAD' : 'Contact Us';
      // Sale price row
      const saleRow = document.getElementById('bm-sale-row');
      if (data.sale) {
        saleRow.style.display = 'block';
        document.getElementById('bm-sale-price').textContent = 'Was $' + Number(data.sale).toLocaleString() + ' CAD';
      } else { saleRow.style.display = 'none'; }
      // Specs
      const parts = data.parts || [];
      document.getElementById('bm-specs').innerHTML = parts.map(p =>
        `<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid rgba(255,255,255,0.05);">
          <span style="font-size:11px;letter-spacing:1px;color:var(--gold);opacity:0.7;text-transform:uppercase;">${esc(p.item||'')}</span>
          <span style="font-size:12px;color:var(--text);text-align:right;max-width:55%;">${esc(p.part||'')}</span>
        </div>`
      ).join('');
      // Inquire button
      const btn = document.getElementById('bm-inquire-btn');
      btn.dataset.name = data.name || '';
      btn.dataset.price = price ? '$' + Number(price).toLocaleString() + ' CAD' : '';
      btn.dataset.type = data.type || 'product';
      // Photos column
      const photoCol = document.getElementById('bm-photo-col');
      if (bmPhotos.length) {
        photoCol.style.display = 'flex';
        renderBM();
      } else {
        photoCol.style.display = 'none';
      }
      document.getElementById('build-modal-overlay').classList.add('open');
      window.lockBodyScroll?.();
      document.querySelector('#build-modal-overlay .modal-close')?.focus();
    };
    function renderBM() {
      document.getElementById('bm-main-img').src = bmPhotos[bmIdx] || '';
      const multi = bmPhotos.length > 1;
      document.getElementById('bm-prev').style.display = multi ? 'flex' : 'none';
      document.getElementById('bm-next').style.display = multi ? 'flex' : 'none';
      document.getElementById('bm-counter').textContent = multi ? `${bmIdx+1} / ${bmPhotos.length}` : '';
      document.getElementById('bm-thumbs').innerHTML = bmPhotos.map((p,i) =>
        `<img src="${esc(safeImgSrc(p))}" onclick="bmSet(${i})" style="width:64px;height:64px;object-fit:contain;padding:4px;border-radius:6px;cursor:pointer;border:2px solid ${i===bmIdx?'var(--gold)':'rgba(255,255,255,0.08)'};background:#0a0a0a;transition:border 0.15s;">`
      ).join('');
    }
    window.bmNav = (d) => { bmIdx = (bmIdx + d + bmPhotos.length) % bmPhotos.length; renderBM(); };
    window.bmSet = (i) => { bmIdx = i; renderBM(); };
    window.closeBuildModal = () => {
      const overlay = document.getElementById('build-modal-overlay');
      if (!overlay.classList.contains('open')) return;
      overlay.classList.remove('open');
      window.unlockBodyScroll?.();
      bmOpener?.focus?.();
    };
    // Enter or Space opens a focused build card, same as a click.
    document.addEventListener('keydown', e => {
      if ((e.key === 'Enter' || e.key === ' ') && e.target.classList?.contains('build-card')) {
        e.preventDefault();
        e.target.click();
      }
    });
    document.addEventListener('keydown', e => {
      if (document.getElementById('build-modal-overlay').classList.contains('open')) {
        if (e.key === 'ArrowLeft' && bmPhotos.length > 1) bmNav(-1);
        if (e.key === 'ArrowRight' && bmPhotos.length > 1) bmNav(1);
        if (e.key === 'Escape') closeBuildModal();
      }
    });

    // Context-aware copy per inquiry type.
    //   product       = ready-to-pickup inventory (already built)
    //   preconfigured = DiamondPC builds we still assemble to order
    const INQUIRY_COPY = {
      product: {
        incentive: "This one is built and ready. Drop your number for a same day text to arrange pickup.",
        confirm: "We'll text you back the same day to set up pickup.",
        depositLabel: 'Hold this PC with a <strong style="color:var(--gold);">$50 deposit</strong> so it is not sold to someone else. Fully refundable. You\'ll see the e-Transfer details as soon as you send this.',
        depositTitle: "HOLD THIS PC, $50 DEPOSIT",
        depositBlurb: "Send an Interac e-Transfer to hold this exact unit for you. We'll text you to confirm it landed and lock in your pickup.",
      },
      preconfigured: {
        incentive: "We build this one to order. Drop your number for a same day text with your quote and timeline.",
        confirm: "We'll text you back the same day with your quote and timeline.",
        depositLabel: 'Reserve your build slot with a <strong style="color:var(--gold);">$50 deposit</strong> that locks in your spot and price. Fully refundable until parts are ordered. You\'ll see the e-Transfer details as soon as you send this.',
        depositTitle: "RESERVE YOUR BUILD, $50 DEPOSIT",
        depositBlurb: "Send an Interac e-Transfer to reserve your build slot and lock today's price. We'll text you to confirm it landed and get started.",
      },
    };

    function applyInquiryCopy(type) {
      const c = INQUIRY_COPY[type] || INQUIRY_COPY.preconfigured;
      document.getElementById('modal-incentive').textContent = c.incentive;
      document.getElementById('modal-deposit-label').innerHTML = c.depositLabel;
      document.getElementById('modal-deposit-title').textContent = c.depositTitle;
      document.getElementById('modal-deposit-blurb').textContent = c.depositBlurb;
      document.getElementById('modal-confirm-text').textContent = c.confirm;
    }

    // Modal
    window.handleInquireClick = (btn) => {
      closeBuildModal();
      document.getElementById('modal-product-name').textContent = btn.dataset.name;
      document.getElementById('modal-product-price').textContent = btn.dataset.price;
      document.getElementById('modal-type').value = btn.dataset.type;
      applyInquiryCopy(btn.dataset.type);
      document.getElementById('modal-overlay').classList.add('open');
      window.lockBodyScroll?.();
      setTimeout(() => document.getElementById('modal-name').focus(), 100);
    };
    window.closeModal = () => {
      document.getElementById('modal-overlay').classList.remove('open');
      window.unlockBodyScroll?.();
      // Reset modal back to the form for the next open.
      const f = document.getElementById('modal-form');
      const c = document.getElementById('modal-confirm');
      const btn = document.getElementById('modal-submit');
      if (c) c.style.display = 'none';
      if (f) { f.style.display = 'block'; f.reset(); }
      if (btn) { btn.textContent = 'Send Inquiry'; btn.disabled = false; }
    };
    document.addEventListener('keydown', e => { if(e.key==='Escape') closeModal(); });

    document.getElementById('modal-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('modal-submit');
      const type = document.getElementById('modal-type').value;
      const wantsDeposit = document.getElementById('modal-deposit').checked;
      const params = {
        name: document.getElementById('modal-name').value,
        email: document.getElementById('modal-email').value,
        phone: document.getElementById('modal-phone').value,
        is_local: document.getElementById('modal-local').value || 'Not specified',
        message: document.getElementById('modal-message').value,
        deposit_intent: wantsDeposit ? 'YES, wants to place $50 deposit' : 'No',
        build_name: document.getElementById('modal-product-name').textContent,
        product_name: document.getElementById('modal-product-name').textContent,
        price: document.getElementById('modal-product-price').textContent,
      };
      btn.textContent = 'Sending...'; btn.disabled = true;
      const emailType = type === 'preconfigured' ? 'preconfigured' : 'product_inquiry';
      try {
        const res = await fetch('/send-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ type: emailType, honeypot: document.getElementById("_hp_")?.value || "", ...params }),
        });
        if (!res.ok) throw new Error();
        // Swap form for the confirmation panel; reveal deposit details if opted in.
        document.getElementById('modal-form').style.display = 'none';
        const dBox = document.getElementById('modal-deposit-box');
        if (wantsDeposit) {
          document.getElementById('modal-deposit-ref').textContent =
            'Deposit ' + (params.name || 'your name');
          dBox.style.display = 'block';
        } else {
          dBox.style.display = 'none';
        }
        document.getElementById('modal-confirm').style.display = 'block';
      } catch {
        window.showToast("That didn't send. Text us at (519) 999-4609 and we'll take it from there. Your details are still in the form.", 'error');
        btn.textContent = 'Send Inquiry'; btn.disabled = false;
      }
    });
  </script>
</BaseLayout>
